# ─────────────────────────────────────────────────────────────────────────────
# Floci Explorer is browser-direct: the hosted UI talks to each developer's OWN
# local Floci/LocalStack instance straight from the browser. The connection
# (endpoint, region, credentials) is configured per-developer in the app's
# Settings page and stored in that browser — NOT here.
#
# For a Railway (or any hosted) deployment you do NOT need to set any of these.
# Railway injects PORT automatically.
#
# The variables below are only a fallback for the legacy server-side data path
# (routes not yet migrated to browser-direct) and for pure local `bun run dev`.
# Use LOCAL/TEST runtimes only (e.g. LocalStack `test`/`test`) — never real
# cloud credentials.
# ─────────────────────────────────────────────────────────────────────────────

# --- AWS / LocalStack (server-side fallback) ---------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4567

# --- Azure / Floci-AZ (server-side fallback) ---------------------------------
# FLOCI_AZURE_ENDPOINT is preferred; FLOCI_AZ_ENDPOINT is accepted as an alias.
# FLOCI_AZURE_ENDPOINT=http://localhost:4577
# FLOCI_AZ_ENDPOINT=http://localhost:4577
# FLOCI_AZURE_ACCOUNT_NAME=devstoreaccount1

# --- GCP / Floci-GCP (server-side fallback) ----------------------------------
# FLOCI_GCP_ENDPOINT is preferred; FLOCI_GP_ENDPOINT is accepted as an alias.
# FLOCI_GCP_ENDPOINT=http://localhost:4588
# FLOCI_GP_ENDPOINT=http://localhost:4588
# FLOCI_GCP_PROJECT=floci-local

# --- Local production server (`bun run start:local`) -------------------------
# `start:local` serves the built SPA and proxies Floci calls same-origin. It
# binds to loopback (127.0.0.1) by default for security; uncomment to override.
# HOST=127.0.0.1
# PORT=3000
